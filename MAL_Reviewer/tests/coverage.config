<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings: measure the application's libraries, not the tests. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*MAL_Reviewer_API\.dll$</ModulePath>
        <ModulePath>.*MAL_Reviewer_Core\.dll$</ModulePath>
      </Include>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
