<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allows building and publishing the Windows app from the Linux dev container. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MAL_Reviewer_UI</RootNamespace>
    <AssemblyName>MAL_Reviewer_UI</AssemblyName>
    <ApplicationIcon>logo.ico</ApplicationIcon>

    <!-- Keeps the layout the forms were designed with on .NET Framework. -->
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>

    <!-- Some resx files hold binary-serialized payloads (ImageListStreamer, bitmaps). -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MAL_Reviewer_Core\MAL_Reviewer_Core.csproj" />
    <ProjectReference Include="..\MAL_Reviewer_API\MAL_Reviewer_API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <!-- The loading animation as a file, so it can be recolored to fit the theme. -->
    <EmbeddedResource Include="images\loading-gifs\loading_gif_control.gif" LogicalName="loading.gif" />
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
