# The development environment of MAL Reviewer: the .NET 11 SDK on Linux.
# It builds, tests and publishes the Windows app; the published app runs on the Windows host.
FROM mcr.microsoft.com/dotnet/sdk:11.0

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    PATH="${PATH}:/root/.dotnet/tools"

WORKDIR /src
